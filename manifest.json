{
    "manifest_version": 3,
    "name": "ClearVoice",
    "version": "0.1.1",
    "description": "Voice-first helper that simplifies highlighted text and reads it aloud.",
    "action": {
        "default_title": "ClearVoice"
    },
    "permissions": [
        "sidePanel",
        "tabs",
        "activeTab"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "sw.js"
    },
    "side_panel": {
        "default_path": "sidepanel.html"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "all_frames": true
        }
    ]
}