{
    "manifest_version": 3,
    "name": "ClearVoice",
    "version": "0.4.0",
    "description": "Student helper: short explanations, multi-language UI, snip OCR + read aloud.",
    "permissions": [
        "activeTab",
        "tabs",
        "scripting",
        "sidePanel",
        "storage"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "sw.js"
    },
    "side_panel": {
        "default_path": "sidepanel.html"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "all_frames": true,
            "run_at": "document_idle"
        }
    ]
}